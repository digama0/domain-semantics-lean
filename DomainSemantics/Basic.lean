import Batteries.CodeAction
import Batteries.Tactic.SeqFocus

/-! # Generic prelude

A small grab-bag of `List`, `Option` and reflexive-transitive-closure
lemmas used throughout the project. Anything that ought to live in
mathlib/batteries but isn't quite there ends up here. The only
domain-specific definition is `ReflTransGen`, which Term.lean's
multi-step weak-head reduction (`WHRedS`) is built on. -/

open Std

attribute [simp] Option.bind_eq_some_iff List.filterMap_cons

protected theorem List.Forall₂.rfl
    {R : α → α → Prop} {l : List α} (h : ∀ a ∈ l, R a a) : l.Forall₂ R l := by
  induction l with
  | nil => constructor
  | cons _ _ ih => simp at h; exact .cons h.1 (ih h.2)

@[simp] theorem List.forall₂_nil_left_iff {l} : Forall₂ R nil l ↔ l = nil :=
  ⟨fun H => by cases H; rfl, by rintro rfl; exact Forall₂.nil⟩

@[simp] theorem List.forall₂_nil_right_iff {l} : Forall₂ R l nil ↔ l = nil :=
  ⟨fun H => by cases H; rfl, by rintro rfl; exact Forall₂.nil⟩

theorem List.forall₂_cons_left_iff {a l u} :
    Forall₂ R (a :: l) u ↔ ∃ b u', R a b ∧ Forall₂ R l u' ∧ u = b :: u' :=
  Iff.intro
    (fun h => match u, h with | b :: u', Forall₂.cons h₁ h₂ => ⟨b, u', h₁, h₂, rfl⟩)
    (fun h => match u, h with | _, ⟨_, _, h₁, h₂, rfl⟩ => Forall₂.cons h₁ h₂)

theorem List.forall₂_cons_right_iff {b l u} :
    Forall₂ R u (b :: l) ↔ ∃ a u', R a b ∧ Forall₂ R u' l ∧ u = a :: u' :=
  Iff.intro
    (fun h => match u, h with | b :: u', Forall₂.cons h₁ h₂ => ⟨b, u', h₁, h₂, rfl⟩)
    (fun h => match u, h with | _, ⟨_, _, h₁, h₂, rfl⟩ => Forall₂.cons h₁ h₂)

@[simp] theorem List.forall₂_map_right_iff {f : γ → β} :
    ∀ {l u}, Forall₂ R l (map f u) ↔ Forall₂ (fun a c => R a (f c)) l u
  | _, [] => by simp only [map, forall₂_nil_right_iff]
  | _, b :: u => by simp only [map, forall₂_cons_right_iff, forall₂_map_right_iff]

theorem List.forall₂_eq {l₁ l₂ : List α} : Forall₂ Eq l₁ l₂ ↔ l₁ = l₂ :=
  ⟨fun h => by induction h <;> simp_all, (· ▸ .rfl fun _ _ => rfl)⟩

theorem List.perm_cons_of_mem {l : List α} (h : a ∈ l) : ∃ l', l.Perm (a :: l') := by
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem h; exact ⟨_, List.perm_middle⟩

theorem List.mapM_eq_some {f : α → Option β} {l : List α} {l' : List β} :
    l.mapM f = some l' ↔ List.Forall₂ (f · = some ·) l l' := by
  induction l generalizing l' with
  | nil => simp only [mapM_nil, pure, Option.some.injEq, forall₂_nil_left_iff, @eq_comm _ l']
  | cons x l ih =>
    simp [mapM_cons, Bind.bind, pure, Option.bind_eq_some_iff, Option.some.injEq,
      forall₂_cons_left_iff, @eq_comm _ l', exists_and_left, ih]

/-- Reflexive-transitive closure of a binary relation `R`, generated by adding
single steps on the right (`tail`). Used in `Term.lean` as the foundation for
multi-step weak-head reduction (`WHRedS = ReflTransGen WHRed`). -/
inductive ReflTransGen (R : α → α → Prop) (a : α) : α → Prop where
  | rfl : ReflTransGen R a a
  | tail : ReflTransGen R a b → R b c → ReflTransGen R a c

theorem ReflTransGen.trans
    (H1 : ReflTransGen R a b) (H2 : ReflTransGen R b c) : ReflTransGen R a c := by
  induction H2 with
  | rfl => exact H1
  | tail h1 h2 ih => exact ih.tail h2

@[elab_as_elim] theorem ReflTransGen.headIndOn {P : (a : α) → ReflTransGen R a z → Prop}
    (rfl : P z .rfl)
    (head : ∀ {x y} (h1 : R x y) (h2 : ReflTransGen R y z),
      P y h2 → P x (.trans (.tail .rfl h1) h2))
    (H : ReflTransGen R a z) : P a H := by
  induction H with
  | rfl => exact rfl
  | tail h1 h2 ih => exact ih (head h2 .rfl rfl) fun a1 a2 => head a1 (.tail a2 h2)

/-! ## Two finite-list lemmas for the cycle argument

`find_cycle` is the pigeonhole step: in a finite list where every element
points somewhere, every element reaches a *self*-pointing one. It is what
turns a descending chain of approximations into a fixed point, and so what
replaces a well-founded minimality argument in a setting where the order
is only a preorder.

`Sublist.union` supplies the join of the lattice of sublists, without
needing `DecidableEq`: the two sublists are merged by walking the ambient
list once and keeping an element as soon as either side keeps it. -/

/-- In a finite list on which `R` is total and transitive, every element
`R`-reaches an element that `R`-relates to itself. -/
theorem find_cycle {α} (R : α → α → Prop)
    (trans : ∀ {x y z}, R x y → R y z → R x z) (l : List α)
    (H : ∀ x ∈ l, ∃ y ∈ l, R x y) : ∀ x ∈ l, ∃ y ∈ l, R x y ∧ R y y := by
  intro x h
  suffices ∀ l₁ l₂, l.Perm (l₁ ++ l₂) → (∀ y ∈ l₂, ∀ z ∈ l, R x z → R y z) →
      ∃ y ∈ l, R x y ∧ R y y from this l [] (by simp) nofun
  intro l₁; generalize eq : l₁.length = i; revert x l₁
  refine i.strongRecOn ?_; rintro i ih x₀ h₀ l₁ rfl l₂ he hl
  have ⟨x', a1, a2⟩ := H x₀ h₀
  obtain hm | hm := List.mem_append.1 (he.mem_iff.1 a1)
  · have ⟨l', hp⟩ := List.perm_cons_of_mem hm
    have he' := he.trans (.append_right _ hp) |>.trans List.perm_middle.symm
    refine have ⟨_, c1, c2, c3⟩ := ih l'.length ?_ _ a1 _ rfl _ he' ?_; ⟨_, c1, trans a2 c2, c3⟩
    · rw [hp.length_eq]; apply Nat.lt_succ_self
    · rintro x' (⟨⟩ | ⟨_, hx⟩) z hz hr <;> [exact hr; exact hl _ hx _ hz (trans a2 hr)]
  · exact ⟨_, a1, a2, hl _ hm _ a1 a2⟩

open List in
/-- All sublists of `l`, enumerated.  `Batteries` has `List.sublists`, but
no lemma identifying its members, and the cycle argument needs the
sublists of a graph as a *finite list of states*. -/
def List.allSublists {α} : List α → List (List α)
  | [] => [[]]
  | a :: l => l.allSublists ++ l.allSublists.map (a :: ·)

open List in
@[simp] theorem List.mem_allSublists {α} {s l : List α} : s ∈ l.allSublists ↔ s <+ l := by
  induction l generalizing s with
  | nil =>
    simp only [allSublists, List.mem_singleton]
    exact ⟨fun h => h ▸ .slnil, fun h => by cases h; rfl⟩
  | cons a l ih =>
    simp only [allSublists, List.mem_append, List.mem_map, ih]
    constructor
    · rintro (h | ⟨t, ht, rfl⟩)
      · exact h.cons a
      · exact ht.cons₂ a
    · intro h
      cases h with
      | cons _ h => exact .inl h
      | cons₂ _ h => exact .inr ⟨_, h, rfl⟩

open List in
/-- Two sublists of a common list have a common sublist upper bound whose
elements come from one or the other. -/
theorem List.Sublist.union : ∀ {α} {l s₁ s₂ : List α}, s₁ <+ l → s₂ <+ l →
    ∃ s, s <+ l ∧ s₁ <+ s ∧ s₂ <+ s ∧ ∀ x ∈ s, x ∈ s₁ ∨ x ∈ s₂ := by
  intro α l
  induction l with
  | nil =>
    intro s₁ s₂ h₁ h₂; cases h₁; cases h₂
    exact ⟨[], .slnil, .slnil, .slnil, nofun⟩
  | cons a l ih =>
    intro s₁ s₂ h₁ h₂
    have keep : ∀ {t₁ t₂ s : List α}, s <+ l → t₁ <+ s → t₂ <+ s →
        (∀ x ∈ s, x ∈ t₁ ∨ x ∈ t₂) →
        ∃ s', s' <+ a :: l ∧ a :: t₁ <+ s' ∧ a :: t₂ <+ s' ∧
          ∀ x ∈ s', x ∈ a :: t₁ ∨ x ∈ a :: t₂ := by
      intro t₁ t₂ s hs h₁ h₂ hm
      exact ⟨a :: s, hs.cons₂ a, h₁.cons₂ a, h₂.cons₂ a, by
        rintro x (_ | ⟨_, hx⟩)
        · exact .inl (.head _)
        · exact (hm x hx).imp (.tail _) (.tail _)⟩
    cases h₁ with
    | cons _ h₁ =>
      cases h₂ with
      | cons _ h₂ =>
        have ⟨s, hs, hs₁, hs₂, hm⟩ := ih h₁ h₂
        exact ⟨s, hs.cons a, hs₁, hs₂, hm⟩
      | cons₂ _ h₂ =>
        have ⟨s, hs, hs₁, hs₂, hm⟩ := ih h₁ h₂
        exact ⟨a :: s, hs.cons₂ a, hs₁.cons a, hs₂.cons₂ a, by
          rintro x (_ | ⟨_, hx⟩)
          · exact .inr (.head _)
          · exact (hm x hx).imp id (.tail _)⟩
    | cons₂ _ h₁ =>
      cases h₂ with
      | cons _ h₂ =>
        have ⟨s, hs, hs₁, hs₂, hm⟩ := ih h₁ h₂
        exact ⟨a :: s, hs.cons₂ a, hs₁.cons₂ a, hs₂.cons a, by
          rintro x (_ | ⟨_, hx⟩)
          · exact .inl (.head _)
          · exact (hm x hx).imp (.tail _) id⟩
      | cons₂ _ h₂ =>
        have ⟨s, hs, hs₁, hs₂, hm⟩ := ih h₁ h₂
        exact keep hs hs₁ hs₂ hm
