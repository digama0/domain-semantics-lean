+    | .inl ⟨T, hT⟩ => exact .inl ⟨T.lift, hT.weak' (Ctx.Lift'.skip (A := A) .refl)⟩
+    | .inr ⟨j, hj⟩ => exact .inr ⟨j+1, by simp [Subst.lift, hj, Term.lift]⟩
